{
  "manifest_version": 3,
  "key": "",
  "name": "تحميل بطاقات الحج - hajjregister.com",
  "description": "تُحمِّل بطاقة التسجيل وبطاقة الطلب العائلي لكل حاجّ من hajjregister.com تلقائيًا، محليًا على جهازك ودون أي خادم خارجي.",
  "version": "1.0.0",
  "permissions": ["debugger", "tabs", "scripting"],
  "host_permissions": ["https://hajjregister.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*",
      "https://*.netlify.app/*"
    ]
  },
  "action": {
    "default_title": "تحميل بطاقات الحج"
  }
}
